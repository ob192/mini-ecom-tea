# Telegram Bot API — required for receiving orders.
# 1. Create a bot via @BotFather and copy the token here.
# 2. Get your chat/channel id (e.g. via @userinfobot or @getidsbot).
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here
TELEGRAM_CHAT_ID=000000000

# Public site URL — used for canonical URLs, sitemap, OpenGraph, robots.
# No trailing slash. In Vercel this is set automatically per-deployment,
# but set it explicitly for stable canonical/OG links.
NEXT_PUBLIC_SITE_URL=https://jintea.restreto-labs.com

# Nova Poshta — server-side only, required by /api/np/cities and /api/np/warehouses.
NOVA_POSHTA_API_KEY=

# Analytics ------------------------------------------------------------------
# GTM container: loads the Google tag (GA4) and reads our dataLayer events.
# Leave empty to disable all tracking (dev, previews).
NEXT_PUBLIC_GTM_ID=GTM-MKJP47L5

# GA4 Measurement Protocol — server-side `purchase` only. The API secret is a
# credential: keep it out of git, set it in Vercel project env vars.
# GA4 → Admin → Data streams → <stream> → Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=G-5PCX5S995S
GA4_API_SECRET=
# Set to 1 to POST to GA4's /debug/mp/collect and log validation errors instead
# of recording real hits.
GA4_MP_DEBUG=
